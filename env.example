# Local development only. Production builds take the backend from the
# committed .env.production (Convex Cloud), whatever is set here or on the host.
# Convex client URL used by the React app.
VITE_CONVEX_URL=https://quick-gull-513.convex.cloud

# Where the browser app sends people to join the android closed test.
# Defaults to https://hookedcue.com/beta if unset.
VITE_BETA_URL=https://hookedcue.com/beta

# Convex HTTP actions/site URL used by Better Auth.
# This is the 3211 domain, not the dashboard domain.
VITE_CONVEX_SITE_URL=https://quick-gull-513.convex.site

# Server-side settings live on the Convex deployment (npx convex env set ...), not here.
# Production (shocking-goldfinch-745): SITE_URL=https://app.hookedcue.com,
# BETTER_AUTH_URL=https://shocking-goldfinch-745.convex.site
SITE_URL=http://localhost:5173
BETTER_AUTH_URL=https://quick-gull-513.convex.site
BETTER_AUTH_SECRET=<generate-with-openssl-rand-base64-32>

# Optional for Convex Cloud only: set this to the real deployment value from Convex.
# Do not use a custom domain label such as hookedcue here; it will break `npx convex dev`.
# CONVEX_DEPLOYMENT=prod:<your-convex-deployment-name>

# Optional for self-hosted/custom Convex CLI usage:
# CONVEX_SELF_HOSTED_URL=https://convex.hookedcue.com
# CONVEX_SELF_HOSTED_ADMIN_KEY=<your-self-hosted-admin-key>

# Dashboard/admin UI only. Do not use this as VITE_CONVEX_SITE_URL.
# CONVEX_DASHBOARD_URL=https://convexdash.hookedcue.com
